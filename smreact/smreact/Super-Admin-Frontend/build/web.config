<?xml version="1.0" encoding="utf-8"?>
<!-- IIS config for the Super Admin SPA.

     The site is served over HTTPS (e.g. https://IP:4105). A browser blocks an
     https page from calling the API at http://IP:4100 (mixed content), and the
     backend sends no CORS header for this origin. So the app calls its OWN
     origin with a relative path and IIS reverse-proxies to the backend server-
     to-server (no mixed content, no CORS) — exactly like the ERP app.

     REQUIRES on the IIS site/server: Application Request Routing ("Enable proxy"
     ON) + URL Rewrite installed. The API (:4100) and AI (:8000) run on this
     same server, so localhost targets work.

     NOTE: deploying build/ overwrites the server's web.config, so these rules
     live here to survive a redeploy — losing them takes every API call down. -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- ERP shared API — branch directory etc. (host :4100) -->
        <rule name="API Proxy" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://localhost:4100/api/{R:1}" />
        </rule>
        <!-- School Permissions — SchoolMentorSuperAdminAPI (host :4100) -->
        <rule name="API Proxy (super admin)" stopProcessing="true">
          <match url="^SchoolMentorSuperAdminAPI/(.*)" />
          <action type="Rewrite" url="http://localhost:4100/SchoolMentorSuperAdminAPI/{R:1}" />
        </rule>
        <!-- Mentor AI / wallet subscriptions. The :8000 service is not reachable
             from this server via localhost (502), but erp.schoolmentor.ai (verified 200) proxies
             it fine, so forward there (server-to-server; browser still sees only
             this same origin). Rule ab wahin forward karta hai. Switch back to localhost:8000 if
             the AI service is later hosted on this box. -->
        <rule name="AI Proxy" stopProcessing="true">
          <match url="^ai/(.*)" />
          <action type="Rewrite" url="https://erp.schoolmentor.ai/ai/{R:1}" />
        </rule>
        <!-- SPA fallback: any non-file/-folder route → index.html so reloads /
             deep links work. The proxy rules above stop first. -->
        <rule name="SPA Routes (superadmin)" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_URI}" pattern="^/api(/|$)" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/SchoolMentorSuperAdminAPI(/|$)" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/ai(/|$)" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
